# Copier en .env puis remplir. Ne jamais publier le fichier .env.

# Domaine du serveur (enregistrement DNS A/AAAA vers cette machine, ports 80 et 443 ouverts).
# « localhost » pour un essai local (certificat interne de Caddy).
DOMAIN=sentinel.exemple.fr

# Mot de passe de la base : long et aléatoire, en hexadécimal (il figure dans une URL).
# Générer par exemple avec : openssl rand -hex 32
POSTGRES_PASSWORD=

# Premier admin : connecte ton appli au serveur, puis
#   docker compose exec server sentinel-server approve <code de l'appareil> --admin

# --- Derrière ton propre reverse proxy (docker-compose.proxy.yml) -----------------------
# Adresse vue par les applis, sous-chemin compris. Remplace DOMAIN.
# PUBLIC_URL=https://sentinel.exemple.fr
# PUBLIC_URL=https://exemple.fr/sentinel
# Proxys autorisés à transmettre l'adresse du client (IP / CIDR, « private » = réseaux privés).
# TRUSTED_PROXIES=private
# En-tête de l'adresse du client : x-forwarded-for, forwarded, x-real-ip, cf-connecting-ip…
# REAL_IP_HEADER=x-forwarded-for
# Port publié pour le proxy (127.0.0.1 : accessible depuis cette machine seulement).
# SERVER_PORT=8080
# BIND_HOST=127.0.0.1

# Facultatif
# TOKEN_TTL_DAYS=30
# DB_MAX_CONNECTIONS=16
# RUST_LOG=sentinel_server=info,tower_http=warn
